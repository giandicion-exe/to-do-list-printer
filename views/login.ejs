<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To Do List - Login</title>
    <link rel="icon" type="image/png" href="/bow2.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --pw-outer-bg: #fae4f0;
            --pw-window-bg: #fdf0f7;
            --pw-window-border: #925875;
            --pw-title-bg: #e1abbf;
            --pw-text-dark: #583346;
            --pw-cream-input: #fffde8;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--pw-outer-bg);
            min-height: 100vh;
            color: var(--pw-text-dark);
        }

        .window-frame {
            background-color: var(--pw-window-bg);
            border: 3px solid var(--pw-window-border);
            border-radius: 20px;
            box-shadow: 0 16px 40px rgba(146, 88, 117, 0.25);
            width: 100%; max-width: 620px;
            overflow: hidden;
            position: relative;
        }

        .window-header {
            background-color: var(--pw-title-bg);
            border-bottom: 3px solid var(--pw-window-border);
            padding: 12px 20px;
            display: flex; align-items: center; justify-content: space-between;
        }

        .window-title { font-weight: 800; font-size: 1.15rem; color: var(--pw-text-dark); margin: 0; }

        .win-btn {
            width: 22px; height: 22px; border: 2px solid var(--pw-window-border);
            background-color: #ffffff; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: bold; cursor: pointer;
        }

        .window-body {
            padding: 40px 30px; position: relative;
            background-image: radial-gradient(var(--pw-title-bg) 2px, transparent 2px);
            background-size: 20px 20px;
        }

        .pixel-art { position: absolute; image-rendering: pixelated; pointer-events: none; }
        .asset-bubble1 { top: 10%; left: 8%; width: 36px; }
        .asset-heart1  { top: 16%; right: 10%; width: 30px; }
        .asset-jelly   { bottom: 8%; right: 8%; width: 48px; }

        .bubble-logo-container {
            position: relative; width: 150px; height: 150px; margin: 0 auto 30px auto;
            display: flex; align-items: center; justify-content: center;
        }

        .bubble-bg { position: absolute; width: 100%; height: 100%; image-rendering: pixelated; transform: scale(1.2); }
        .pixel-bow { width: 75px; position: relative; z-index: 2; image-rendering: pixelated; transform: scale(1.3); }

        .form-row { display: flex; align-items: center; justify-content: center; margin-bottom: 16px; gap: 14px; }
        .form-row label { width: 110px; text-align: right; font-weight: 800; font-size: 0.95rem; }

        .pixel-input-box {
            width: 100%; max-width: 320px; height: 46px;
            background-color: var(--pw-cream-input);
            border: 2px solid var(--pw-window-border); border-radius: 14px;
            padding: 0 16px; display: flex; align-items: center;
        }

        .pixel-control {
            background: transparent; border: none; outline: none; width: 100%;
            font-weight: 600; font-size: 0.95rem; color: var(--pw-text-dark);
        }

        .pixel-btn-link { background: none; border: none; cursor: pointer; transition: transform 0.15s ease; }
        .pixel-btn-link:hover { transform: scale(1.08); }
        .pixel-btn-img { height: 32px; width: auto; image-rendering: pixelated; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">

    <div class="window-frame">
        <div class="window-header">
            <h1 class="window-title">My To Do List - Login</h1>
            <div class="d-flex gap-2">
                <div class="win-btn">_</div>
                <div class="win-btn">□</div>
                <div class="win-btn">×</div>
            </div>
        </div>

        <div class="window-body">
            <img src="/bubble1.png" alt="" class="pixel-art asset-bubble1">
            <img src="/heart1.png" alt="" class="pixel-art asset-heart1">
            <img src="/jelly.png" alt="" class="pixel-art asset-jelly">

            <div class="bubble-logo-container">
                <img src="/bubble1.png" alt="" class="bubble-bg">
                <img src="/bow1.png" alt="" class="pixel-bow">
            </div>

            <% if (error) { %>
                <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2 text-center mb-3 small fw-bold" style="background-color: var(--pw-outer-bg);">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-row">
                    <label for="studentId">School ID :</label>
                    <div class="pixel-input-box">
                        <input type="text" id="studentId" name="studentId" class="pixel-control" placeholder="01-2526-000000" required>
                    </div>
                </div>

                <div class="form-row">
                    <label for="fullName">Full Name :</label>
                    <div class="pixel-input-box">
                        <input type="text" id="fullName" name="fullName" class="pixel-control" placeholder="Samantha Rose" required>
                    </div>
                </div>

                <div class="form-row">
                    <label for="email">School Acc :</label>
                    <div class="pixel-input-box">
                        <input type="email" id="email" name="email" class="pixel-control" placeholder="@phinmaed.com" required>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="pixel-btn-link">
                        <img src="/loginbutt.png" alt="" class="pixel-btn-img">
                    </button>
                    <a href="/register" class="pixel-btn-link">
                        <img src="/registerbutt.png" alt="" class="pixel-btn-img">
                    </a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>