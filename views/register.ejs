<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To Do List - Register</title>
    <link rel="icon" type="image/png" href="/bow2.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --pw-outer-bg: #fae4f0;
            --pw-window-bg: #fdf0f7;
            --pw-window-border: #925875;
            --pw-title-bg: #e1abbf;
            --pw-text-dark: #583346;
            --pw-cream-input: #fffde8;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--pw-outer-bg);
            min-height: 100vh;
            color: var(--pw-text-dark);
        }

        .window-frame {
            background-color: var(--pw-window-bg);
            border: 3px solid var(--pw-window-border);
            border-radius: 16px;
            box-shadow: 0 12px 35px rgba(146, 88, 117, 0.2);
            width: 100%;
            max-width: 680px;
            overflow: hidden;
            position: relative;
        }

        .window-header {
            background-color: var(--pw-title-bg);
            border-bottom: 3px solid var(--pw-window-border);
            padding: 10px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .window-title {
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--pw-text-dark);
            margin: 0;
        }

        .window-controls {
            display: flex;
            gap: 6px;
        }

        .win-btn {
            width: 20px;
            height: 20px;
            border: 1.5px solid var(--pw-window-border);
            background-color: #ffffff;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            color: var(--pw-text-dark);
            cursor: pointer;
            user-select: none;
        }

        .window-body {
            padding: 40px 30px;
            position: relative;
            background-image: radial-gradient(var(--pw-title-bg) 2px, transparent 2px);
            background-size: 20px 20px;
        }

        .pixel-art {
            position: absolute;
            image-rendering: pixelated;
            pointer-events: none;
            filter: drop-shadow(0px 2px 0px rgba(0,0,0,0.05));
        }

        .asset-bubble1 { top: 10%; left: 10%; width: 36px; }
        .asset-bubble2 { top: 38%; right: 8%; width: 32px; }
        .asset-bubble3 { bottom: 18%; left: 8%; width: 28px; }
        .asset-heart1  { top: 16%; right: 12%; width: 28px; }
        .asset-heart2  { bottom: 30%; left: 12%; width: 24px; }
        .asset-jelly   { bottom: 10%; right: 10%; width: 44px; }
        .asset-sparkle1{ top: 48%; left: 6%; width: 20px; }
        .asset-sparkle2{ top: 26%; left: 22%; width: 22px; }
        .asset-sparkle3{ bottom: 16%; right: 24%; width: 24px; }

        .bubble-logo-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto 30px auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bubble-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            object-fit: contain;
            image-rendering: pixelated;
            filter: drop-shadow(0 4px 6px rgba(146, 88, 117, 0.15));
            transform: scale(1.3);
        }

        .pixel-bow {
            width: 75px;
            height: auto;
            position: relative;
            z-index: 2;
            image-rendering: pixelated;
            transform: scale(1.4);
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            gap: 14px;
        }

        .form-row label {
            width: 110px;
            text-align: right;
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--pw-text-dark);
            margin: 0;
            white-space: nowrap;
        }

        .pixel-input-box {
            width: 100%;
            max-width: 320px;
            height: 44px;
            background-color: var(--pw-cream-input);
            border: 2px solid var(--pw-window-border);
            border-radius: 14px;
            display: flex;
            align-items: center;
            padding: 0 16px;
        }

        .pixel-control {
            background: transparent !important;
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            width: 100%;
            height: 100%;
            font-family: 'Poppins', sans-serif;
            font-size: 0.9rem;
            color: var(--pw-text-dark);
        }

        .pixel-control::placeholder {
            color: #bd9bb0;
            font-style: italic;
        }

        .action-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin-top: 24px;
        }

        .pixel-btn-link {
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            display: inline-block;
            transition: transform 0.15s ease;
            text-decoration: none;
        }

        .pixel-btn-link:hover {
            transform: scale(1.08);
        }

        .pixel-btn-img {
            height: 32px;
            width: auto;
            image-rendering: pixelated;
        }

        .popup-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background-color: rgba(88, 51, 70, 0.4);
            backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            z-index: 9999;
            opacity: 0; visibility: hidden;
            transition: all 0.3s ease-in-out;
        }

        .popup-overlay.show {
            opacity: 1; visibility: visible;
        }

        .popup-card {
            background-color: var(--pw-window-bg);
            border: 3px solid var(--pw-window-border);
            border-radius: 18px;
            width: 90%; max-width: 380px;
            box-shadow: 0 10px 30px rgba(146, 88, 117, 0.3);
            transform: scale(0.8);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-align: center;
            overflow: hidden;
        }

        .popup-overlay.show .popup-card {
            transform: scale(1);
        }

        .popup-header {
            background-color: var(--pw-title-bg);
            border-bottom: 2px solid var(--pw-window-border);
            padding: 8px 14px;
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--pw-text-dark);
        }

        .popup-body {
            padding: 24px 20px;
        }

        .popup-ribbon-bow {
            width: 64px; height: auto;
            image-rendering: pixelated;
            margin-bottom: 12px;
            animation: bounce 1.2s infinite ease-in-out;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .popup-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--pw-text-dark);
            margin-bottom: 6px;
        }

        .popup-text {
            font-size: 0.88rem;
            color: #784862;
            margin-bottom: 20px;
        }

        .popup-ok-btn {
            background-color: var(--pw-title-bg);
            border: 2px solid var(--pw-window-border);
            color: var(--pw-text-dark);
            font-weight: 700;
            padding: 8px 28px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 0.9rem;
        }

        .popup-ok-btn:hover {
            background-color: #d69bb1;
            transform: scale(1.05);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">

    <div class="window-frame">
        <div class="window-header">
            <h1 class="window-title">My To Do List - Register</h1>
            <div class="window-controls">
                <div class="win-btn">_</div>
                <div class="win-btn">□</div>
                <div class="win-btn">×</div>
            </div>
        </div>

        <div class="window-body">
            <img src="/bubble1.png" alt="" class="pixel-art asset-bubble1">
            <img src="/bubble2.png" alt="" class="pixel-art asset-bubble2">
            <img src="/bubble3.png" alt="" class="pixel-art asset-bubble3">
            <img src="/heart1.png" alt="" class="pixel-art asset-heart1">
            <img src="/heart2.png" alt="" class="pixel-art asset-heart2">
            <img src="/jelly.png" alt="" class="pixel-art asset-jelly">
            <img src="/sparkle1.png" alt="" class="pixel-art asset-sparkle1">
            <img src="/sparkle2.png" alt="" class="pixel-art asset-sparkle2">
            <img src="/sparkle3.png" alt="" class="pixel-art asset-sparkle3">

            <div class="bubble-logo-container">
                <img src="/bubble1.png" alt="" class="bubble-bg">
                <img src="/bow1.png" alt="" class="pixel-bow">
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger border-0 shadow-sm rounded-3 py-2 text-center text-danger mb-3 small" style="background-color: var(--pw-outer-bg);">
                    <%= error %>
                </div>
            <% } %>

            <form id="registerForm" action="/register" method="POST">
                <div class="form-row">
                    <label for="studentId">School ID :</label>
                    <div class="pixel-input-box">
                        <input type="text" id="studentId" name="studentId" class="pixel-control" placeholder="01-2526-000000" required>
                    </div>
                </div>

                <div class="form-row">
                    <label for="fullName">Full Name :</label>
                    <div class="pixel-input-box">
                        <input type="text" id="fullName" name="fullName" class="pixel-control" placeholder="Samantha Rose" required>
                    </div>
                </div>

                <div class="form-row">
                    <label for="email">School Acc :</label>
                    <div class="pixel-input-box">
                        <input type="email" id="email" name="email" class="pixel-control" placeholder="@phinmaed.com" required>
                    </div>
                </div>

                <div class="action-buttons">
                    <button type="submit" class="pixel-btn-link">
                        <img src="/registerbutt.png" alt="" class="pixel-btn-img">
                    </button>
                    
                    <a href="/login" class="pixel-btn-link">
                        <img src="/loginbutt.png" alt="" class="pixel-btn-img">
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div id="successModal" class="popup-overlay">
        <div class="popup-card">
            <div class="popup-header">Notification</div>
            <div class="popup-body">
                <img src="/bow1.png" alt="" class="popup-ribbon-bow">
                <div class="popup-title">Registered Successfully!</div>
                <div class="popup-text">Your account has been created. Click below to continue.</div>
                <button type="button" id="confirmOkBtn" class="popup-ok-btn">CONTINUE</button>
            </div>
        </div>
    </div>

    <script>
        const registerForm = document.getElementById('registerForm');
        const successModal = document.getElementById('successModal');
        const confirmOkBtn = document.getElementById('confirmOkBtn');

        registerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            successModal.classList.add('show');
        });

        confirmOkBtn.addEventListener('click', function() {
            registerForm.submit();
        });
    </script>

</body>
</html>